84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,222,114,67,29,24,72,243,141,128,195,
78,66,215,61,156,180);

int prm(int i){return P[i&255];}

vec3 grad(int i)
{
    if(i==0)return vec3(1,1,0);
    if(i==1)return vec3(-1,1,0);
    if(i==2)return vec3(1,-1,0);
    if(i==3)return vec3(-1,-1,0);
    if(i==4)return vec3(1,0,1);
    if(i==5)return vec3(-1,0,1);
    if(i==6)return vec3(1,0,-1);
    if(i==7)return vec3(-1,0,-1);
    if(i==8)return vec3(0,1,1);
    if(i==9)return vec3(0,-1,1);
    if(i==10)return vec3(0,1,-1);
    return vec3(0,-1,-1);
}

float corner(int gi,float x,float y,float z)
{
    float t=.6-x*x-y*y-z*z;
    if(t<=0.)return 0.;
    t*=t;
    return t*t*dot(grad(gi),vec3(x,y,z));
}

float snoise(vec3 v)
{
    float s=(v.x+v.y+v.z)/3.;
    int i=int(floor(v.x+s)),j=int(floor(v.y+s)),k=int(floor(v.z+s));
    float t=float(i+j+k)/6.;
    float x0=v.x-(float(i)-t),y0=v.y-(float(j)-t),z0=v.z-(float(k)-t);

    int i1,j1,k1,i2,j2,k2;
    if(x0>=y0){
        if(y0>=z0){i1=1;j1=0;k1=0;i2=1;j2=1;k2=0;}
        else if(x0>=z0){i1=1;j1=0;k1=0;i2=1;j2=0;k2=1;}
        else{i1=0;j1=0;k1=1;i2=1;j2=0;k2=1;}
    }else if(y0<z0){i1=0;j1=0;k1=1;i2=0;j2=1;k2=1;}
    else if(x0<z0){i1=0;j1=1;k1=0;i2=0;j2=1;k2=1;}
    else{i1=0;j1=1;k1=0;i2=1;j2=1;k2=0;}

    float g=1./6.;
    float x1=x0-float(i1)+g,y1=y0-float(j1)+g,z1=z0-float(k1)+g;
    float x2=x0-float(i2)+2.*g,y2=y0-float(j2)+2.*g,z2=z0-float(k2)+2.*g;
    float x3=x0-.5,y3=y0-.5,z3=z0-.5;

    int ii=i&255,jj=j&255,kk=k&255;
    int gi0=prm(ii+prm(jj+prm(kk)))%12;
    int gi1=prm(ii+i1+prm(jj+j1+prm(kk+k1)))%12;
    int gi2=prm(ii+i2+prm(jj+j2+prm(kk+k2)))%12;
    int gi3=prm(ii+1+prm(jj+1+prm(kk+1)))%12;

    return 32.*(corner(gi0,x0,y0,z0)+corner(gi1,x1,y1,z1)+corner(gi2,x2,y2,z2)+corner(gi3,x3,y3,z3));
}

float fbm(vec3 p)
{
    float v=0.,a=.78;
    for(int i=0;i<3;i++){v+=a*snoise(p);p*=4.;a*=.09;}
    return v;
}

vec3 rotY(vec3 p,float a)
{
    float s=sin(a),c=cos(a);
    return vec3(c*p.x+s*p.z,p.y,-s*p.x+c*p.z);
}

float map(vec3 p)
{
    vec3 c=vec3(0,0,5);
    vec3 q=rotY(p-c,-iTime*.025);
    q.z+=iTime*.1;
    return length(p-c)-2.2+fbm(q*2.5)*.110;
}

vec3 normal(vec3 p)
{
    vec3 a=vec3(1,-1,-1),b=vec3(-1,-1,1),c=vec3(-1,1,-1),d=vec3(1,1,1);
    return normalize(a*map(p+a*EPS)+b*map(p+b*EPS)+c*map(p+c*EPS)+d*map(p+d*EPS));
}

vec3 shade(vec3 ro,vec3 p)
{
    vec3 n=normal(p),l=normalize(vec3(20,10,-20)-p),v=normalize(ro-p);
    float dif=max(dot(n,l),0.);
    float spe=dif>0.?pow(max(dot(reflect(-l,n),v),0.),40.)*.8:0.;
    vec3 col=ALBEDO*vec3(.65,.68,.95)*.25+ALBEDO*dif+vec3(spe);
    return pow(max(col,0.),vec3(1./2.2));
}

void main()
{
    vec2 uv=(2.*fragCoord.xy-iResolution.xy)/iResolution.y;
    vec3 ro=vec3(0,0,2.15);
    vec3 rd=normalize(vec3(uv*.57735027,1));

    float t=.05,d;
    bool hit=false;

    for(int i=0;i<256;i++)
    {
        d=map(ro+rd*t);
        if(d<EPS){hit=true;break;}
        t+=max(d,MIN_STEP);
        if(t>FAR)break;
    }

    fragColor=vec4(hit?shade(ro,ro+rd*t):vec3(.65,.68,.95),1);
}
